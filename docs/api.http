# File: docs/api.http
# Usage: Manual end-to-end checks for the VS Code REST Client extension
#        (humao.rest-client). This is intentionally ordered as a tutorial.
#
# Before sending requests:
#   1. Start the local stack and wait for GET /readyz to return 200.
#   2. Set @email and @password to the bootstrap-admin credentials from .env.
#   3. Send requests in numerical order. Login saves @token; Create saves @productId.
#   4. The heading of every request states its expected status. Error requests
#      demonstrate intended behavior, not bugs.
#
# The REST Client extension runs this file inside VS Code. No RestClient MCP is
# configured in this workspace, so automated checks use local HTTP commands.

@baseUrl = http://localhost:8080/api/v1
@email = admin@example.com
@password = change-me-please-123
# Change this code before repeating the create request, or use the duplicate
# request below deliberately to observe the expected 409 response.
@productCode = MURABAHA{{$timestamp}}

###############################################################################
# 0. Health (no login needed)
###############################################################################

### Is the API alive?
GET http://localhost:8080/healthz

### Are PostgreSQL and Valkey reachable? Expected: 200 with {"status":"ready"}.
GET http://localhost:8080/readyz

### Prometheus monitoring text through Nginx. Expected: 404 in dev by design.
# Nginx intentionally blocks /metrics. This confirms the public edge does not expose metrics.
GET http://localhost:8080/metrics

### Minimum supported mobile app version. Expected: 200 JSON.
GET {{baseUrl}}/app/config

###############################################################################
# 1. Login  (click "Send Request" here first; the token is reused below)
###############################################################################

# @name login
POST {{baseUrl}}/admin/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### The token from the login response is saved here automatically
@token = {{login.response.body.access_token}}

###############################################################################
# 2. Products CRUD
###############################################################################

### Create a product. Expected: 201. It also saves its id for requests below.
# @name createProduct
POST {{baseUrl}}/admin/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "{{productCode}}",
  "name": "Murabaha financing",
  "description": "Short-term trade financing",
  "currency": "AFN",
  "min_amount": "1000.00",
  "max_amount": "50000.00",
  "annual_rate": "12.50",
  "status": "active"
}

###
@productId = {{createProduct.response.body.id}}

### Duplicate code while the original product still exists. Expected: 409.
POST {{baseUrl}}/admin/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "{{productCode}}",
  "name": "Duplicate product",
  "currency": "AFN",
  "min_amount": "1000.00",
  "max_amount": "50000.00",
  "annual_rate": "12.50"
}

### List products (page 1, 20 per page)
GET {{baseUrl}}/admin/products?page=1&page_size=20
Authorization: Bearer {{token}}

### List only active products whose name or code contains "mura"
GET {{baseUrl}}/admin/products?status=active&q=mura
Authorization: Bearer {{token}}

### Get one product
GET {{baseUrl}}/admin/products/{{productId}}
Authorization: Bearer {{token}}

### Update a product (code and currency cannot change)
PUT {{baseUrl}}/admin/products/{{productId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Murabaha financing (updated)",
  "description": "Updated description",
  "min_amount": "2000.00",
  "max_amount": "60000.00",
  "annual_rate": "11.00",
  "status": "active"
}

### Download all products as Excel (use "Save Response Body" to keep the file)
GET {{baseUrl}}/admin/exports/products
Authorization: Bearer {{token}}

### Delete a product (soft delete, returns 204)
DELETE {{baseUrl}}/admin/products/{{productId}}
Authorization: Bearer {{token}}

###############################################################################
# 3. Error cases (these SHOULD fail; use them to see the error format)
###############################################################################

### 401: no token
GET {{baseUrl}}/admin/products

### 400: invalid data (max below min, bad currency)
POST {{baseUrl}}/admin/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "BAD1",
  "name": "Bad product",
  "currency": "XX",
  "min_amount": "5000.00",
  "max_amount": "100.00",
  "annual_rate": "12.50"
}

### 404: product does not exist
GET {{baseUrl}}/admin/products/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}

### 401: wrong password (5 wrong tries in a row lock the account for 15 minutes)
POST {{baseUrl}}/admin/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "wrong-password"
}

### 400: invalid query parameter (page must be at least 1)
GET {{baseUrl}}/admin/products?page=0
Authorization: Bearer {{token}}

### 404: confirm the deleted product is no longer visible.
# Send this only after the Delete request above; it should return 404.
GET {{baseUrl}}/admin/products/{{productId}}
Authorization: Bearer {{token}}

### 400: unknown JSON field is rejected by the router's strict JSON decoder
POST {{baseUrl}}/admin/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "UNKNOWNFIELD1",
  "name": "Unknown field example",
  "currency": "AFN",
  "min_amount": "1000.00",
  "max_amount": "50000.00",
  "annual_rate": "12.50",
  "not_in_the_contract": true
}

# Do not repeatedly send the wrong-password request above: the fifth failed
# attempt triggers the intentional 15-minute account lockout (429).
