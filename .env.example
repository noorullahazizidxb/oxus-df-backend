# File: .env.example
# Usage: Template for your local settings. Copy it to .env (cp .env.example .env).
#        Vault for staging/production secrets is planned but not added yet (see README).

OXUS_ENV=development
OXUS_LOG_LEVEL=info
OXUS_HTTP_ADDR=:8080
# Comma separated CIDRs of reverse proxies (Nginx) whose X-Forwarded-For is trusted.
OXUS_HTTP_TRUSTED_PROXIES=

OXUS_DATABASE_URL=postgres://oxus:oxus@localhost:5432/oxus?sslmode=disable
OXUS_DATABASE_MAX_CONNS=10
OXUS_VALKEY_URL=redis://localhost:6379/0

# >= 32 chars. Generate one with: openssl rand -base64 48
OXUS_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
OXUS_JWT_ISSUER=oxus-df
OXUS_JWT_TTL=15m

OXUS_RATE_LIMIT_REQUESTS=300
OXUS_RATE_LIMIT_WINDOW=1m
OXUS_LOGIN_MAX_ATTEMPTS=5
OXUS_LOGIN_LOCK_WINDOW=15m

# Created only when no admin user exists yet. Remove after the first start.
OXUS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
OXUS_BOOTSTRAP_ADMIN_PASSWORD=change-me-please-123

OXUS_APP_MIN_VERSION=1.0.0
